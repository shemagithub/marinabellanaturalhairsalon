{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "corepack enable && corepack prepare pnpm@11.9.0 --activate && CI=true pnpm install --frozen-lockfile",
  "buildCommand": "CI=true BASE_PATH=/ pnpm --filter @workspace/mallinabella-salon run build",
  "outputDirectory": "artifacts/mallinabella-salon/dist/public",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
